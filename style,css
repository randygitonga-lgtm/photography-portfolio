body {
    font-family: Georgia, serif;
    background-color: #f4f1ec;
    color: #333;
    margin: 0;
}
header {
    background-color: #222;
    color: #white;
    padding: 40px 20px;
    text-align: center;
}
header em {
    font-style: italic;
    color: #e0b84c;
}
 h2 {
    font-weight: bold;
    border-bottom: 2px solid #e0b84c;
    padding-bottom: 8px;
}
.intro, .bio, .gallery, .contact {
    max-width: 800px;
    margin: 40px auto;
    padding: 0 20px;
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 8px;
}
.bio img {
    max-width: 150px;
    border-radius: 50%;
    margin-right: 20px;
    height: 150px;
    object-fit: cover;
}
.photo-grid {
    width: 100%;
    display: grid;
    gap: 15px;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
}
.photo-grid img {
    width: 100%;
    height: 200px;
    border: 3px solid #222;
    object-fit: cover;
}
.photo-grid img:hover {
    border-color: #e0b84c;
    opacity: 0.85;
}
label {
    display: block;
    margin-top: 15px;
    font-weight: bold;
}
input, textarea {
    width: 100%;
    padding: 9px;
    margin-top: 5px;
    border: 1px solid #aaa;
    box-sizing: border-box;
}
input:focus, textarea:focus {
    border-color: #e0b84c;
    outline: none;
}
button {
    background-color: #222;
    color: white;
    padding: 10px 20px;
    border: none;
    margin-top: 15px;
    cursor: pointer;
}
button:hover {
    background-color: #e0b84c;
    color: #222;
}
footer {
    text-align: center;
    padding: 20px;
    background-color: #222;
    color: white;
    margin-top: 40px;
}